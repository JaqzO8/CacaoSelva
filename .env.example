# Copiar a .env.local en la raíz y completar. No subir contraseñas al repositorio.
CACAOSELVA_DB_URL=jdbc:postgresql://127.0.0.1:55432/cacaoselva
CACAOSELVA_DB_USER=cacaoselva
CACAOSELVA_DB_PASSWORD=
CACAOSELVA_JWT_SECRET=
CACAOSELVA_ADMIN_PASSWORD=
# Opcional para Monitor. Usa solo una credencial de un usuario con acceso de lectura.
CACAOSELVA_API_BASE_URL=http://localhost:5080
CACAOSELVA_API_USERNAME=
CACAOSELVA_API_PASSWORD=
# Alternativa a usuario/contraseña (token temporal; no guardarlo en Git).
CACAOSELVA_API_TOKEN=
